# Git fun
alias gst='git status'
alias gf='git fetch'
alias gp='git pull'
alias gpf='git push --force-with-lease'
alias gcm='git checkout master'
alias gco='git checkout'
alias gb='git branch | tail -n 100 | grep -v master | grep -v main'
alias gd='git diff'
alias ci='git commit -m' # requires you to type a commit message

function git_base_branch() {
  if [[ "$(basename "$PWD")" == "upstart_web" ]]; then
    echo master
  else
    echo main
  fi
}

function grem() {
  local base
  base=$(git_base_branch)
  git fetch
  git rebase "origin/${base}"
}

function gup() {
  grem && git push --force-with-lease
}

function guppush() {
  gup
}

function openpr() {
  # Uses Github CLI
  gh pr view -w
}

function createpr() {
  local branch_name remote_url repo_path

  branch_name=$(git branch --show-current)
  if [[ -z "$branch_name" ]]; then
    echo "createpr: cannot create a PR from detached HEAD" >&2
    return 1
  fi

  remote_url=$(git remote get-url --push origin 2>/dev/null || git remote get-url origin 2>/dev/null)
  if [[ -z "$remote_url" ]]; then
    echo "createpr: no origin remote found" >&2
    return 1
  fi

  case "$remote_url" in
    git@github.com:*.git)
      repo_path=${remote_url#git@github.com:}
      repo_path=${repo_path%.git}
      ;;
    git@github.com:*)
      repo_path=${remote_url#git@github.com:}
      ;;
    https://github.com/*.git)
      repo_path=${remote_url#https://github.com/}
      repo_path=${repo_path%.git}
      ;;
    https://github.com/*)
      repo_path=${remote_url#https://github.com/}
      ;;
    ssh://git@github.com/*.git)
      repo_path=${remote_url#ssh://git@github.com/}
      repo_path=${repo_path%.git}
      ;;
    ssh://git@github.com/*)
      repo_path=${remote_url#ssh://git@github.com/}
      ;;
    *)
      echo "createpr: unsupported GitHub origin remote: $remote_url" >&2
      return 1
      ;;
  esac

  open "https://github.com/${repo_path}/pull/new/${branch_name}"
}

function creategdpr() {
  branch_name=`git symbolic-ref HEAD | cut -d"/" -f 3,4`;
  open https://github.com/teamupstart/greendot/pull/new/$branch_name
}

function createmspr() {
  branch_name=`git symbolic-ref HEAD | cut -d"/" -f 3,4`;
  open https://github.com/teamupstart/mobile/pull/new/$branch_name
}

function createuwfpr() {
  branch_name=`git symbolic-ref HEAD | cut -d"/" -f 3,4`;
  open https://github.com/teamupstart/upstart-web-frontend/pull/new/$branch_name
}

# Alternatively, you can go with git add . && git commit --amend --no-edit
# if you don't want to edit the commit message
function smooshgit() {
  git commit -m "WIP"
  git rebase --interactive HEAD~2
}

function ship() {
  smooshgit && gup
}

function shippr() {
  ship && createpr
}

# I don't really use these
alias ga='git add'
alias gap='git add -p'
alias gbl='git blame -w -M -C'
alias gdm='git diff master'
alias amend='git commit --amend --no-edit'
alias gpu='git push'
alias staged='git diff --cached'
alias gl="git l"

function gitcleanmerged() {
  local branches
  branches=$(git for-each-ref --merged HEAD --format='%(refname:short)' refs/heads | while read -r branch; do
    if [[ "$branch" != "main" && "$branch" != "master" ]]; then
      echo "$branch"
    fi
  done)
  if [[ -n "$branches" ]]; then
    echo "$branches" | xargs git branch -d --
  fi
}

function git_non_base_branches() {
  git for-each-ref --format='%(refname:short)' refs/heads | while read -r branch; do
    if [[ "$branch" != "main" && "$branch" != "master" ]]; then
      echo "$branch"
    fi
  done
}

function git_checkout_base_branch() {
  local current_branch checkout_branch

  current_branch=$(git branch --show-current)
  if [[ "$current_branch" == "main" || "$current_branch" == "master" ]]; then
    return 0
  fi

  if git show-ref --verify --quiet refs/heads/main; then
    checkout_branch=main
  elif git show-ref --verify --quiet refs/heads/master; then
    checkout_branch=master
  else
    echo "gitclean: no local main or master branch to check out before deleting non-base branches" >&2
    return 1
  fi

  git checkout "$checkout_branch" || return 1
}

function gitcleanforce() {
  local branches
  git_checkout_base_branch || return 1
  branches=$(git_non_base_branches)
  if [[ -n "$branches" ]]; then
    echo "$branches" | xargs git branch -D --
  fi
}

function gitclean() {
  gitcleanforce
}
